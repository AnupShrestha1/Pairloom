    <path android:fillColor="#00000000" android:strokeColor="#402BB3AC" android:strokeWidth="15"
        android:pathData="M42,54m-16,0a16,16 0,1 1,32 0a16,16 0,1 1,-32 0" />
    <path android:fillColor="#00000000" android:strokeColor="#40F2A93B" android:strokeWidth="15"
